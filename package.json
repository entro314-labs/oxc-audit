{
  "name": "@entro314-labs/oxc-audit",
  "version": "1.3.1",
  "description": "Deterministically audit a project's stack and configure the Oxc toolchain around it - oxlint, tsgolint and oxfmt",
  "keywords": [
    "audit",
    "formatter",
    "linter",
    "oxc",
    "oxfmt",
    "oxlint",
    "static-analysis",
    "tsgolint",
    "typescript"
  ],
  "license": "MIT",
  "author": "Dominikos Pritis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entro314-labs/oxc-audit.git"
  },
  "bin": {
    "oxc-audit": "dist/bin/oxc-audit.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.mts",
    "import": "./dist/src/index.mjs"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin .",
    "lint:fix": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix .",
    "lint:fix-unsafe": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "check:fix-suggestions": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions . && oxfmt --write src/",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm check && pnpm build",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "commander": "15.0.0",
    "jsonc-parser": "4.0.0-next.2",
    "picocolors": "^1.1.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "next",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
