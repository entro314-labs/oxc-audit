{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "quoteProps": "as-needed",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "off", // no embedded languages in CLI code
  "proseWrap": "preserve",

  // JSX options omitted - no JSX in CLI projects

  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    "package-lock.json",
    // The plugin package follows the Oxlint plugin ecosystem's style (tabs, semicolons,
    // double quotes), not the CLI's. It runs its own lint and typecheck via `pnpm check`.
    "plugins",
    // Prose is hand-written and hand-wrapped. Formatting it gains nothing, and it put
    // `prepublishOnly` at the mercy of any stray Markdown sitting in the working tree.
    "**/*.md",
  ],

  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown",
      // no "style" group - CLIs don't import CSS
    ],
    "internalPattern": ["~/", "@/", "#"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true,
    "sortSideEffects": false,
  },

  "sortPackageJson": true,
}
