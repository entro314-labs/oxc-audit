{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "jsPlugins": [
    "./src/next-react/index.ts",
    "./src/data-layer/index.ts",
    "./src/ai-integrations/index.ts",
    "./src/ts-tooling/index.ts",
    "./src/slop-stop/index.ts",
    "./src/supabase/index.ts",
    "./src/web-security/index.ts"
  ],

  "plugins": ["typescript", "promise", "import", "unicorn", "vitest", "oxc", "react", "nextjs"],

  "categories": { "correctness": "error" },

  "rules": {
    "next-react/no-cache-primitive-outside-server-action": "error",
    "next-react/no-client-hooks-in-server-component": "error",
    "next-react/no-dynamic-before-interactive-script": "error",
    "next-react/no-edge-runtime": "warn",
    "next-react/no-legacy-context-provider": "warn",
    "next-react/no-legacy-next-modules": "error",
    "next-react/no-middleware-file": "warn",
    "next-react/no-removed-next-config-keys": "error",
    "next-react/require-await-next-request-apis": "error",

    "data-layer/no-drizzle-legacy-api": "error",
    "data-layer/no-field-array-index-key": "error",
    "data-layer/no-react-query-removed-exports": "error",
    "data-layer/no-react-query-v4-options": "error",
    "data-layer/no-rhf-setvalue-loop": "warn",
    "data-layer/no-zod-legacy-error-params": "error",
    "data-layer/no-zod-removed-methods": "error",
    "data-layer/no-zod-safe-parse-json-parse": "error",
    "data-layer/no-zod-shape-spread-drops-refinements": "error",
    "data-layer/no-zod-trim-after-min-length": "error",
    "data-layer/no-zod-single-arg-record": "warn",
    "data-layer/no-zod-string-format-methods": "warn",
    "data-layer/no-zod-to-json-schema-package": "error",
    "data-layer/no-zustand-v4-import-paths": "error",
    "data-layer/require-async-parse-for-async-schema": "error",
    "data-layer/require-zustand-curried-create": "error",

    "ai-integrations/no-ai-v6-exports": "error",
    "ai-integrations/no-ai-v6-options": "error",
    "ai-integrations/no-ai-v6-result-members": "error",
    "ai-integrations/no-stripe-unverified-webhook": "error",
    "ai-integrations/no-stripe-v21-api": "error",
    "ai-integrations/require-stripe-async-webhook": "error",

    "supabase/no-browser-client-on-server": "error",
    "supabase/no-deprecated-auth-helpers": "error",
    "supabase/no-get-session-for-authorization": "error",
    "supabase/no-module-scope-server-client": "error",
    "supabase/require-error-check": "error",

    "web-security/no-hardcoded-credential": "error",
    "web-security/no-insecure-randomness": "error",
    "web-security/no-shell-injection": "error",
    "web-security/require-sanitized-html": "error",

    "no-eval": "error",
    "no-new-func": "error",
    "no-implied-eval": "error",
    "no-script-url": "error",
    "unicorn/require-post-message-target-origin": "error",

    "ts-tooling/no-removed-vitest-config": "error",
    "ts-tooling/no-removed-vitest-exports": "error",

    "slop-stop/no-chained-type-assertions": "error",
    "slop-stop/no-widen-then-assert": "error",
    "slop-stop/no-known-value-widening": "warn",
    "slop-stop/no-unsafe-dictionary-type": "warn",
    "slop-stop/require-safety-comment-for-type-assertion": "warn",

    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true, "minimumDescriptionLength": 3 }
    ],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unsafe-declaration-merging": "error",

    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-useless-catch": "error",
    "unicorn/error-message": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/throw-new-error": "error",
    "promise/always-return": "error",
    "promise/catch-or-return": "error",
    "promise/no-return-wrap": "error",
    "promise/prefer-await-to-then": "warn",

    "import/no-duplicates": "error",
    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "import/no-self-import": "error",

    "vitest/expect-expect": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-identical-title": "error",
    "vitest/hoisted-apis-on-top": "error",
    "vitest/require-awaited-expect-poll": "error",
    "vitest/valid-expect": ["error", { "asyncMatchers": ["toMatchFileSnapshot", "toResolve", "toReject"] }],

    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }],
    "typescript/no-misused-spread": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/promise-function-async": "warn",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "warn",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": "warn"
  },

  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx,js,jsx}", "**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": { "typescript/no-explicit-any": "warn" }
    }
  ]
}
